# Copy this file to .env and fill in your values
# Then: source .env before running cdk commands

# AWS account ID (12-digit number)
export CDK_ACCOUNT=123456789012

# AWS region
export CDK_REGION=us-east-1

# Existing VPC to deploy into
export VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# Two public subnets in different AZs within the VPC
export SUBNET1=subnet-xxxxxxxxxxxxxxxxx
export SUBNET2=subnet-xxxxxxxxxxxxxxxxx

# Optional: override AZs if auto-derived from region is wrong
# export AZ1=us-east-1a
# export AZ2=us-east-1b
